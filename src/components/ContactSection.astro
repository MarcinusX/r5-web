---
const socialLinks = [
  {
    name: 'Facebook',
    url: 'https://www.facebook.com/profile.php?id=61576316956069',
    icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
]

const registrationLinks = {
  open5km: 'https://time4s.pl/retkinska-piatka-2026-open-5km',
  dzieci: 'https://time4s.pl/retkinska-piatka-2026-dzieci',
}

const startListLinks = {
  open5km: 'https://time4s.pl/lista-startowa/retkinska-piatka-2026-open-5km',
  dzieci: 'https://time4s.pl/lista-startowa/retkinska-piatka-2026-dzieci',
}
---

<section id="kontakt" class="relative py-24 lg:py-32 bg-brand-teal-dark overflow-hidden">
  <!-- Diagonal accent -->
  <div class="absolute bottom-0 left-0 w-full h-1/3 bg-brand-teal transform -skew-y-3 origin-bottom-left" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Contact Info -->
      <div class="space-y-8">
        <div class="space-y-4">
          <span class="section-label text-white/40 before:bg-brand-yellow">Kontakt</span>
          <h2 class="font-display text-5xl lg:text-6xl xl:text-7xl text-white">
            Masz<br/>
            <span class="text-brand-yellow">pytania?</span>
          </h2>
        </div>

        <p class="text-white/70 text-lg leading-relaxed max-w-lg">
          Chętnie odpowiemy na wszystkie pytania dotyczące biegu, rejestracji czy możliwości partnerstwa.
        </p>

        <!-- Contact details -->
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-brand-yellow flex items-center justify-center">
              <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-white/50 text-xs font-headline uppercase tracking-wider mb-1">Email</div>
              <a href="mailto:kontakt@retkinskapiatka.pl" class="text-white hover:text-brand-yellow transition-colors font-body text-lg">
                kontakt@retkinskapiatka.pl
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-brand-yellow flex items-center justify-center">
              <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-white/50 text-xs font-headline uppercase tracking-wider mb-1">Organizator</div>
              <div class="text-white font-body">
                Parafia Najświętszej Eucharystii<br/>
                <span class="text-white/60">Łódź - Retkinia</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="pt-8 border-t border-white/10">
          <div class="text-white/50 text-xs font-headline uppercase tracking-wider mb-4">Śledź nas</div>
          <div class="flex gap-4">
            {socialLinks.map(social => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 bg-white/10 hover:bg-brand-yellow flex items-center justify-center transition-colors group"
                aria-label={social.name}
              >
                <svg class="w-5 h-5 text-white group-hover:text-ink transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d={social.icon} />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Registration CTA Card -->
      <div id="zapisz-sie" class="relative bg-white overflow-hidden shadow-2xl">
        <!-- Corner accents -->
        <div class="absolute top-0 left-0 w-12 h-12 border-t-[3px] border-l-[3px] border-brand-yellow" aria-hidden="true"></div>
        <div class="absolute bottom-0 right-0 w-12 h-12 border-b-[3px] border-r-[3px] border-brand-yellow" aria-hidden="true"></div>


        <div class="relative z-10 p-8 lg:p-12 flex flex-col items-center text-center gap-6">
          <!-- Label -->
          <span class="font-headline text-xs uppercase tracking-[0.2em] text-brand-teal-light">III Edycja · 13.09.2026</span>

          <!-- Heading -->
          <h3 class="font-display text-4xl lg:text-5xl text-ink">
            Dołącz do nas!
          </h3>

          <!-- CTA Buttons: two distances -->
          <div class="flex flex-col gap-3 w-full max-w-xs">
            <a
              href={registrationLinks.open5km}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full justify-center text-lg py-4"
            >
              <span>Bieg główny 5 km</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href={registrationLinks.dzieci}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary-outline w-full justify-center text-base py-3"
            >
              <span>Bieg dzieci</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <!-- Divider -->
          <div class="w-16 h-px bg-ink/10"></div>

          <!-- Quick links -->
          <div class="flex gap-6 text-sm">
            <a
              href="https://www.facebook.com/profile.php?id=61576316956069"
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-teal hover:text-brand-teal-dark transition-colors font-headline uppercase tracking-wide"
            >
              Fanpage
            </a>
            <button
              type="button"
              data-dropdown="dropdown-lista"
              class="text-brand-teal hover:text-brand-teal-dark transition-colors font-headline uppercase tracking-wide cursor-pointer"
            >
              Lista startowa
            </button>
            <a href="#poprzednie-edycje" class="text-brand-teal hover:text-brand-teal-dark transition-colors font-headline uppercase tracking-wide">
              Wyniki 2025
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Registration dropdown (anchored under whichever "Zapisz się" button was clicked) -->
  <div
    id="dropdown-zapisz"
    class="js-dropdown fixed z-[60] w-64 bg-white shadow-2xl border border-ink/10 opacity-0 scale-95 pointer-events-none origin-top transition-[opacity,transform] duration-150"
    role="menu"
    aria-hidden="true"
  >
    <div class="p-3 flex flex-col gap-2">
      <a
        href={registrationLinks.open5km}
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
        class="btn-primary w-full justify-between text-sm py-3 px-4"
      >
        <span>Bieg główny</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href={registrationLinks.dzieci}
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
        class="btn-primary-outline w-full justify-between text-sm py-3 px-4"
      >
        <span>Bieg dzieci</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Start list dropdown (anchored under whichever "Lista startowa" button was clicked) -->
  <div
    id="dropdown-lista"
    class="js-dropdown fixed z-[60] w-64 bg-white shadow-2xl border border-ink/10 opacity-0 scale-95 pointer-events-none origin-top transition-[opacity,transform] duration-150"
    role="menu"
    aria-hidden="true"
  >
    <div class="p-3 flex flex-col gap-2">
      <a
        href={startListLinks.open5km}
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
        class="btn-primary-outline w-full justify-between text-sm py-3 px-4"
      >
        <span>Bieg główny</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href={startListLinks.dzieci}
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
        class="btn-primary-outline w-full justify-between text-sm py-3 px-4"
      >
        <span>Bieg dzieci</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  let currentAnchor: HTMLElement | null = null
  let currentDropdown: HTMLElement | null = null

  function positionDropdown(anchor: HTMLElement, dropdown: HTMLElement) {
    const rect = anchor.getBoundingClientRect()
    const gap = 8
    const margin = 8
    const ddWidth = dropdown.offsetWidth
    const viewportWidth = document.documentElement.clientWidth

    let left = rect.right - ddWidth
    if (left < margin) left = margin
    if (left + ddWidth > viewportWidth - margin) left = viewportWidth - ddWidth - margin

    dropdown.style.top = `${rect.bottom + gap}px`
    dropdown.style.left = `${left}px`
  }

  function openDropdown(anchor: HTMLElement, dropdown: HTMLElement) {
    currentAnchor = anchor
    currentDropdown = dropdown
    positionDropdown(anchor, dropdown)
    dropdown.classList.remove('opacity-0', 'scale-95', 'pointer-events-none')
    dropdown.classList.add('opacity-100', 'scale-100')
    dropdown.setAttribute('aria-hidden', 'false')
  }

  function closeDropdown() {
    if (!currentDropdown) return
    currentDropdown.classList.add('opacity-0', 'scale-95', 'pointer-events-none')
    currentDropdown.classList.remove('opacity-100', 'scale-100')
    currentDropdown.setAttribute('aria-hidden', 'true')
    currentAnchor = null
    currentDropdown = null
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    const opener = target.closest('[data-dropdown]') as HTMLElement | null
    if (opener) {
      e.preventDefault()
      const dropdown = document.getElementById(opener.dataset.dropdown || '')
      if (!dropdown) return
      const wasOpen = currentAnchor === opener
      closeDropdown()
      if (!wasOpen) openDropdown(opener, dropdown)
      return
    }
    if (currentDropdown && !currentDropdown.contains(target)) {
      closeDropdown()
    }
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && currentAnchor) {
      closeDropdown()
    }
  })

  window.addEventListener('resize', () => {
    if (currentAnchor && currentDropdown) positionDropdown(currentAnchor, currentDropdown)
  })

  window.addEventListener('scroll', () => {
    if (currentAnchor && currentDropdown) positionDropdown(currentAnchor, currentDropdown)
  }, { passive: true })
</script>
