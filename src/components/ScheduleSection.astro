---
const base = import.meta.env.BASE_URL;
const scheduleItems = [
  { time: '13:00', title: 'Otwarcie biura zawodów', description: 'Dom parafialny. Odbiór pakietów startowych: biegi dzieci do 14:30, bieg główny do 15:30' },
  { time: '14:30', title: 'Piknik rodzinny', description: 'Strefa atrakcji dla całych rodzin (14:30–17:30)' },
  { time: '14:40', title: 'Rozgrzewka dla dzieci', description: 'Wspólna rozgrzewka przed biegami najmłodszych' },
  { time: '14:50', title: 'Start biegu 300 m – dzieci', description: 'Rocznik 2020 i młodsi' },
  { time: '15:00', title: 'Koronka do Bożego Miłosierdzia', description: 'Wspólna modlitwa na scenie' },
  { time: '15:10', title: 'Start biegu 500 m – dzieci', description: 'Roczniki 2019–2013' },
  { time: '15:20', title: 'Bieg w byle czym', description: 'Liczy się przede wszystkim kreatywność i przebranie! Dostępny dla wszystkich chętnych, bez rejestracji' },
  { time: '15:30', title: 'Dekoracje biegów dzieci', description: 'Wręczenie nagród najmłodszym uczestnikom' },
  { time: '15:40', title: 'Wspólna rozgrzewka', description: 'Rozgrzewka przed biegiem głównym prowadzona przez Fit Fabric' },
  { time: '16:00', title: 'Start biegu głównego', description: 'Bieg na dystansie 5 km', isHighlight: true },
  { time: '16:40', title: 'Licytacje', description: 'Charytatywny konkret' },
  { time: '17:00', title: 'Dekoracja biegu głównego', description: 'Wręczenie nagród i medali' },
  { time: '17:30', title: 'Zakończenie imprezy', description: 'Planowane zakończenie wydarzenia' },
]
---

<section id="harmonogram" class="relative scroll-mt-14 lg:scroll-mt-16 pt-10 lg:pt-14 pb-10 lg:pb-14 bg-paper-warm overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-brand-yellow/5 rounded-full -translate-y-1/2 translate-x-1/2" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-brand-teal/5 rounded-full translate-y-1/2 -translate-x-1/2" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
      <h2 class="font-display text-5xl lg:text-6xl xl:text-7xl text-brand-teal">
        Harmonogram
      </h2>
      <p class="mt-4 text-lg text-ink-muted">
        Niedziela, 13 września 2026 · Kościół Najświętszej Eucharystii, ul. Popiełuszki 9
      </p>
    </div>

    <div class="grid gap-12 lg:gap-16 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] max-w-6xl mx-auto items-start">

    <!-- Timeline -->
    <div class="max-w-2xl mx-auto w-full">
      {scheduleItems.map((item, index) => (
        <div class={`timeline-item ${item.isHighlight ? 'is-highlight' : ''}`}>
          <!-- Time -->
          <div class="timeline-time">
            <span class={`font-display text-2xl lg:text-3xl ${item.isHighlight ? 'text-brand-yellow' : 'text-brand-teal'}`}>
              {item.time}
            </span>
          </div>

          <!-- Dot & Line -->
          <div class="timeline-marker">
            <div class={`timeline-dot ${item.isHighlight ? 'highlight' : ''}`}>
              {item.isHighlight && <div class="timeline-dot-ping"></div>}
            </div>
            {index < scheduleItems.length - 1 && <div class="timeline-line"></div>}
          </div>

          <!-- Content -->
          <div class={`timeline-content ${item.isHighlight ? 'bg-brand-teal p-5' : ''}`}>
            <h3 class={`font-headline text-xl lg:text-2xl ${item.isHighlight ? 'text-white' : 'text-ink'}`}>
              {item.title}
            </h3>
            <p class={`text-sm mt-1 ${item.isHighlight ? 'text-white/80' : 'text-ink-muted'}`}>
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Mapa miasteczka -->
    <div id="miasteczko" class="scroll-mt-24 lg:sticky lg:top-24 max-w-md mx-auto w-full">
      <a
        href={`${base}images/mapa-miasteczka.pdf`}
        target="_blank"
        rel="noopener"
        class="group block rounded-lg overflow-hidden shadow-xl ring-1 ring-brand-teal/10 bg-white"
        title="Otwórz mapę w PDF"
      >
        <img
          src={`${base}images/mapa-miasteczka.png`}
          alt="Plan miasteczka biegowego przy kościele: meta na ul. Balonowej, scena, punkt medyczny, strefa zabaw, biuro zawodów w domu parafialnym, toalety, szatnia, strefa gastro i strefa partnerów"
          width="1414"
          height="2000"
          loading="lazy"
          class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </a>
      <p class="mt-3 text-center text-sm text-ink-muted">
        Kliknij mapę, aby otworzyć ją w pełnym rozmiarze (PDF).
      </p>
    </div>

    </div>
  </div>
</section>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: 80px 24px 1fr;
    gap: 16px;
    align-items: start;
    min-height: 80px;
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 60px 20px 1fr;
      gap: 12px;
    }
  }

  .timeline-time {
    text-align: right;
    padding-top: 2px;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .timeline-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--color-paper-warm);
    border: 3px solid var(--color-brand-teal);
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .timeline-dot.highlight {
    width: 20px;
    height: 20px;
    background-color: var(--color-brand-yellow);
    border-color: var(--color-brand-yellow);
    margin-top: 2px;
  }

  .timeline-dot-ping {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background-color: var(--color-brand-yellow);
    animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    min-height: 40px;
    background-color: var(--color-brand-teal);
    opacity: 0.2;
    margin-top: 8px;
  }

  .timeline-content {
    padding-bottom: 24px;
  }

  .timeline-item.is-highlight .timeline-content {
    margin-top: -4px;
    margin-bottom: 16px;
  }
</style>
