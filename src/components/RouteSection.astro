---
const base = import.meta.env.BASE_URL;
const routeHighlights = [
  { label: 'Start', value: 'Biedronka, Maratońska 93' },
  { label: 'Meta', value: 'Kościół, Popiełuszki 9' },
  { label: 'Dystans', value: '5 km' },
  { label: 'Nawierzchnia', value: 'Asfalt' },
  { label: 'Profil', value: 'Praktycznie płaska' },
  { label: 'Mapa', value: 'Google Maps', isLink: true, href: 'https://maps.app.goo.gl/qEG9MzSA4WU5NPgm8' },
]
---

<section id="trasa" class="relative py-24 lg:py-32 bg-brand-teal-dark overflow-hidden">
  <!-- Diagonal accent -->
  <div class="absolute top-0 right-0 w-1/2 h-full bg-brand-teal transform -skew-x-12 origin-top-right" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Map -->
      <div class="relative order-2 lg:order-1">
        <div class="relative aspect-square bg-white/5 backdrop-blur-sm border border-white/10 p-4">
          <button
            type="button"
            data-route-video-open
            class="route-map-trigger group relative block w-full h-full overflow-hidden cursor-pointer"
            aria-label="Odtwórz film z trasą biegu"
          >
            <img
              src={`${base}images/route-map.png`}
              alt="Mapa trasy biegu Retkińska Piątka - 5km przez Retkini"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Darkening overlay on hover -->
            <div class="absolute inset-0 bg-brand-teal-dark/0 group-hover:bg-brand-teal-dark/30 transition-colors duration-300"></div>

            <!-- Play CTA -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
              <div class="route-play-cta relative flex items-stretch shadow-[0_12px_40px_rgba(0,0,0,0.35)]">
                <!-- Pulsing rings -->
                <span class="absolute inset-0 border-2 border-brand-yellow/60 route-pulse-ring" aria-hidden="true"></span>
                <span class="absolute inset-0 border-2 border-brand-yellow/40 route-pulse-ring route-pulse-ring-delayed" aria-hidden="true"></span>

                <!-- Triangle play mark -->
                <div class="relative flex items-center justify-center bg-brand-yellow px-5 py-4">
                  <svg viewBox="0 0 16 18" class="w-5 h-6 fill-brand-teal-dark" aria-hidden="true">
                    <polygon points="0,0 16,9 0,18" />
                  </svg>
                </div>
                <!-- Label -->
                <div class="relative flex flex-col justify-center bg-brand-teal-dark text-left px-5 py-3 border-t-2 border-b-2 border-r-2 border-brand-yellow">
                  <span class="font-headline text-brand-yellow text-[10px] tracking-[0.25em] uppercase opacity-80">Film</span>
                  <span class="font-display text-white text-xl tracking-wider leading-none">Trasa 5 km</span>
                </div>
              </div>
            </div>
          </button>

          <!-- Corner markers -->
          <div class="absolute top-2 left-2 w-4 h-4 border-t-2 border-l-2 border-brand-yellow pointer-events-none"></div>
          <div class="absolute top-2 right-2 w-4 h-4 border-t-2 border-r-2 border-brand-yellow pointer-events-none"></div>
          <div class="absolute bottom-2 left-2 w-4 h-4 border-b-2 border-l-2 border-brand-yellow pointer-events-none"></div>
          <div class="absolute bottom-2 right-2 w-4 h-4 border-b-2 border-r-2 border-brand-yellow pointer-events-none"></div>
        </div>

        <!-- PZLA Badge -->
        <div class="absolute -bottom-4 -right-4 bg-white px-6 py-3 shadow-lg">
          <div class="font-headline text-brand-teal text-sm uppercase tracking-wider">
            Atest PZLA
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="space-y-8 order-1 lg:order-2">
        <div class="space-y-4">
          <span class="section-label text-white/60 before:bg-brand-yellow">Trasa</span>
          <h2 class="font-display text-5xl lg:text-6xl xl:text-7xl text-white">
            Poznaj<br/>
            <span class="text-brand-yellow">trasę biegu</span>
          </h2>
        </div>

        <p class="text-white/70 text-lg leading-relaxed max-w-lg">
          Trasa prowadzi ulicami dzielnicy Retkinia. Płaski profil sprawia,
          że jest idealna zarówno dla amatorów, jak i tych, którzy chcą pobić życiówkę!
        </p>

        <!-- Route highlights -->
        <div class="grid sm:grid-cols-2 gap-4">
          {routeHighlights.map(item => (
            item.isLink ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 bg-white/5 border-l-2 border-brand-yellow hover:bg-white/10 transition-colors group">
                <div>
                  <div class="text-white/50 text-xs font-headline uppercase tracking-wider">
                    {item.label}
                  </div>
                  <div class="text-brand-yellow font-headline text-lg mt-0.5 flex items-center gap-2 group-hover:text-white transition-colors">
                    {item.value}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </div>
                </div>
              </a>
            ) : (
              <div class="flex items-center gap-4 p-4 bg-white/5 border-l-2 border-brand-yellow">
                <div>
                  <div class="text-white/50 text-xs font-headline uppercase tracking-wider">
                    {item.label}
                  </div>
                  <div class="text-white font-headline text-lg mt-0.5">
                    {item.value}
                  </div>
                </div>
              </div>
            )
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Video Modal -->
  <div
    id="route-video-modal"
    class="route-modal fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Film z trasą biegu"
  >
    <!-- Backdrop -->
    <div class="route-modal-backdrop absolute inset-0 bg-black/90 backdrop-blur-md" data-route-video-close></div>

    <!-- Modal content -->
    <div class="route-modal-content relative w-full max-w-6xl">
      <!-- Yellow accent header strip -->
      <div class="flex items-center justify-between bg-brand-yellow px-4 py-2">
        <div class="flex items-center gap-3">
          <span class="inline-block w-2 h-2 bg-brand-teal-dark"></span>
          <span class="font-headline text-brand-teal-dark text-xs sm:text-sm uppercase tracking-[0.25em]">
            Retkińska Piątka · Trasa 5 km
          </span>
        </div>
        <button
          type="button"
          data-route-video-close
          class="route-close-btn font-headline text-brand-teal-dark text-xs uppercase tracking-[0.2em] flex items-center gap-2 hover:gap-3 transition-all"
          aria-label="Zamknij film"
        >
          <span class="hidden sm:inline">Zamknij</span>
          <svg viewBox="0 0 16 16" class="w-4 h-4 stroke-current" fill="none" stroke-width="2" aria-hidden="true">
            <line x1="2" y1="2" x2="14" y2="14"/>
            <line x1="14" y1="2" x2="2" y2="14"/>
          </svg>
        </button>
      </div>

      <!-- Video container -->
      <div class="relative bg-black">
        <video
          id="route-video-player"
          class="w-full h-auto block"
          controls
          playsinline
          preload="none"
          poster={`${base}images/route-map.png`}
        >
          <source src={`${base}nagranie-1280.webm`} type="video/webm" />
          <source src={`${base}nagranie-1280.mp4`} type="video/mp4" />
          Twoja przeglądarka nie wspiera odtwarzania wideo.
        </video>

        <!-- Corner markers on video -->
        <div class="absolute top-2 left-2 w-4 h-4 border-t-2 border-l-2 border-brand-yellow pointer-events-none"></div>
        <div class="absolute top-2 right-2 w-4 h-4 border-t-2 border-r-2 border-brand-yellow pointer-events-none"></div>
        <div class="absolute bottom-2 left-2 w-4 h-4 border-b-2 border-l-2 border-brand-yellow pointer-events-none"></div>
        <div class="absolute bottom-2 right-2 w-4 h-4 border-b-2 border-r-2 border-brand-yellow pointer-events-none"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Play button pulse rings */
  @keyframes routePulseRing {
    0% { transform: scale(1); opacity: 0.9; }
    70% { transform: scale(1.35); opacity: 0; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  .route-pulse-ring {
    animation: routePulseRing 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .route-pulse-ring-delayed {
    animation-delay: 1.2s;
  }

  /* Slight lift of the CTA on hover of the whole trigger */
  .route-map-trigger:hover .route-play-cta {
    transform: translateY(-2px) scale(1.03);
  }
  .route-play-cta {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Modal open state */
  .route-modal.is-open {
    display: flex;
    animation: routeFadeIn 0.25s ease forwards;
  }

  .route-modal.is-open .route-modal-content {
    animation: routeModalIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes routeFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes routeModalIn {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .route-close-btn:hover {
    opacity: 0.75;
  }

  /* Lock scroll when modal open */
  body.route-modal-open {
    overflow: hidden;
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .route-pulse-ring,
    .route-map-trigger img,
    .route-play-cta,
    .route-modal.is-open,
    .route-modal.is-open .route-modal-content {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const modal = document.getElementById('route-video-modal');
  const video = document.getElementById('route-video-player') as HTMLVideoElement | null;
  const openTriggers = document.querySelectorAll('[data-route-video-open]');
  const closeTriggers = document.querySelectorAll('[data-route-video-close]');

  function openModal() {
    if (!modal) return;
    modal.classList.add('is-open');
    document.body.classList.add('route-modal-open');
    if (video) {
      video.currentTime = 0;
      video.play().catch(() => { /* user gesture may still be required */ });
    }
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    document.body.classList.remove('route-modal-open');
    if (video) {
      video.pause();
    }
  }

  openTriggers.forEach(el => el.addEventListener('click', openModal));
  closeTriggers.forEach(el => el.addEventListener('click', closeModal));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
      closeModal();
    }
  });
</script>
