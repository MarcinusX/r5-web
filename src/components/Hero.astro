---
// Event data - update for each edition
const eventDateFormatted = '13.09.2026'

// Wyniki 2026 (time4s.pl)
const results = [
  { name: 'Wyniki OPEN 5 km', desc: 'klasyfikacja generalna', url: 'https://time4s.pl/uploads/wyniki-open-retkinska-5-6aa6b8ffd057f.pdf' },
  { name: 'Wyniki kategorie', desc: 'kategorie wiekowe i specjalne', url: 'https://time4s.pl/uploads/wyniki-kategorie-retkinska-5-6aa6bc6d01215.pdf' },
]
const resultsPage = 'https://time4s.pl/wyniki'
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-brand-teal-dark">
  <!-- Large decorative 5 -->
  <div class="absolute -right-20 top-1/2 -translate-y-1/2 font-display text-[40rem] lg:text-[60rem] text-white/[0.03] leading-none pointer-events-none select-none" aria-hidden="true">
    5
  </div>

  <!-- Diagonal accent stripe -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -right-1/4 top-0 w-1/2 h-full bg-brand-yellow/10 transform skew-x-12"></div>
  </div>

  <!-- Content -->
  <div class="container-wide relative z-10 pt-32 pb-20 lg:pt-40 lg:pb-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left: Text Content -->
      <div class="space-y-8">
        <!-- Edition Badge -->
        <div class="inline-flex items-center gap-3 opacity-0 animate-fade-in-up">
          <span class="px-4 py-1.5 bg-brand-yellow text-ink font-headline text-sm uppercase tracking-wider">
            III Edycja
          </span>
        </div>

        <!-- Main Headline -->
        <div class="opacity-0 animate-fade-in-up delay-100">
          <h1 class="font-display text-6xl sm:text-7xl lg:text-8xl xl:text-9xl text-white leading-none flex items-baseline gap-4">
            <span>Retkińska</span>
            <span class="text-brand-yellow">5</span>
          </h1>
        </div>

        <!-- Subheadline -->
        <div class="space-y-3 opacity-0 animate-fade-in-up delay-200">
          <p class="text-xl lg:text-2xl text-white/70 font-body font-normal max-w-lg">
            Charytatywny bieg parafialny ulicami Retkini.
          </p>
          <p class="flex items-center gap-2 text-white/90 font-body text-lg">
            <svg class="w-5 h-5 text-brand-yellow flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>Bieg za nami – dziękujemy wszystkim uczestnikom!</span>
          </p>
        </div>

        <!-- CTA -->
        <div class="flex flex-wrap gap-4 opacity-0 animate-fade-in-up delay-300">
          <a href="#wyniki" class="btn-primary">
            Zobacz wyniki
          </a>
          <a href="#poprzednie-edycje" class="btn-secondary">
            Zdjęcia i poprzednie edycje
          </a>
        </div>
      </div>

      <!-- Right: Results card -->
      <div id="wyniki" class="relative scroll-mt-24 opacity-0 animate-scale-in delay-200">
        <div class="relative bg-white/5 backdrop-blur-sm border border-white/10 p-8 lg:p-12">
          <!-- Corner accents -->
          <div class="absolute top-0 left-0 w-16 h-16 border-t-4 border-l-4 border-brand-yellow"></div>
          <div class="absolute bottom-0 right-0 w-16 h-16 border-b-4 border-r-4 border-brand-yellow"></div>

          <div class="text-center space-y-6">
            <div class="text-brand-yellow font-headline text-sm uppercase tracking-widest">
              {eventDateFormatted} · Łódź - Retkinia
            </div>

            <!-- Big heading -->
            <h2 class="font-display text-5xl lg:text-7xl text-white leading-none">
              Wyniki <span class="text-brand-yellow">2026</span>
            </h2>

            <!-- Result links -->
            <div class="space-y-3 pt-2">
              {results.map(r => (
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-4 bg-brand-yellow text-ink px-5 py-4 text-left hover:bg-white transition-colors duration-200"
                >
                  <svg class="w-8 h-8 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6M7 4h7l5 5v11a1 1 0 01-1 1H7a1 1 0 01-1-1V5a1 1 0 011-1z" />
                  </svg>
                  <span class="flex-1">
                    <span class="block font-headline text-lg uppercase tracking-wide">{r.name}</span>
                    <span class="block text-sm text-ink/70">{r.desc} · PDF</span>
                  </span>
                  <svg class="w-5 h-5 flex-shrink-0 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>

            <div class="pt-4 border-t border-white/10 text-white/60 font-body text-sm">
              Wyniki biegów dzieci pojawią się wkrótce.<br/>
              Pomiar czasu:
              <a href={resultsPage} target="_blank" rel="noopener noreferrer" class="text-brand-yellow hover:text-white underline underline-offset-4 transition-colors">time4s.pl</a>
            </div>
          </div>
        </div>

        <!-- Floating badge - Atest PZLA -->
        <div class="absolute -top-4 -right-4 lg:-top-6 lg:-right-6 bg-brand-yellow text-ink px-4 py-2 font-headline text-sm uppercase tracking-wide transform rotate-3 shadow-lg">
          Atest PZLA
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40 opacity-0 animate-fade-in delay-600">
    <span class="text-xs uppercase tracking-widest font-headline">Przewiń</span>
    <div class="w-px h-12 bg-gradient-to-b from-white/40 to-transparent animate-pulse"></div>
  </div>
</section>
