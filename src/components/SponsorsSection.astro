---
const patron = {
  name: "Patronat Honorowy Prezydenta Miasta Łodzi Hanny Zdanowskiej",
  logo: "/sponsors/Prezydent-Miasta-Lodzi-Hanna-Zdanowska.png",
};

const mainPartner = {
  name: "Pizzeria Kultowa",
  logo: "/sponsors/pizzeria-kultowa.webp",
  url: "https://pizzeriakultowa.pl/",
};

const sponsors = [
  {
    name: "Sante",
    logo: "/sponsors/sante.png",
    url: "https://sante.pl/",
    scale: 1.2,
  },
  {
    name: "Pawęta - mięsa dojrzewające",
    logo: "/sponsors/paweta.svg",
    url: "https://www.paweta.com/",
    scale: 0.9,
  },
  {
    name: "Podkawa",
    logo: "/sponsors/podkawa.png",
    url: "https://podkawa.pl/",
    scale: 1.6,
    hidden: false,
  },
  {
    name: "Tor Łódź",
    logo: "/sponsors/tor-lodz.svg",
    url: "https://tor-lodz.pl/",
    scale: 1.3,
  },
  {
    name: "ZPM Grot",
    logo: "/sponsors/grot.png",
    url: "https://zpmgrot.pl/pl/",
  },
  {
    name: "Święcicki Zdrój",
    logo: "/sponsors/swiecicki.png",
    url: "https://swiecickizdroj.pl/",
  },
  {
    name: "Netto",
    logo: "/sponsors/netto.png",
    url: "https://netto.pl/",
    caption: ["ul. Wyszyńskiego 107", "ul. Maratońska 109A"],
    captionOffset: -32,
  },
  {
    name: "Fit Fabric",
    logo: "/sponsors/fitfabric.webp",
    url: "https://fitfabric.pl/",
    caption: "Galeria Retkińska",
  },
];

const visibleSponsors = sponsors.filter((s) => !s.hidden);

// Split sponsors into rows of up to 3, but rebalance so the last row never has
// just a single item (e.g. 7 -> 3/2/2 instead of 3/3/1, 4 -> 2/2 instead of 3/1).
function arrangeRows(items) {
  const rows = [];
  for (let i = 0; i < items.length; i += 3) {
    rows.push(items.slice(i, i + 3));
  }
  if (rows.length >= 2 && rows[rows.length - 1].length === 1) {
    rows[rows.length - 1].unshift(rows[rows.length - 2].pop());
  }
  return rows;
}

const sponsorRows = arrangeRows(visibleSponsors);
---

<section id="partnerzy" class="relative pt-12 lg:pt-16 pb-12 lg:pb-16 bg-paper overflow-hidden">
  <!-- Decorative element -->
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-teal via-brand-yellow to-brand-teal"></div>

  <!-- Subtle diagonal background accent -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/2 -right-1/4 w-[80%] h-[200%] bg-brand-teal/[0.02] rotate-12 origin-center"></div>
  </div>

  <div class="container-wide relative z-10">
    <!-- Patronat honorowy -->
    <div class="text-center mb-20">
      <h2 class="section-heading text-brand-teal">Patronat honorowy</h2>
      <div class="flex justify-center mt-8">
        <div class="patron-logo-wrap">
          <img
            src={patron.logo}
            alt={patron.name}
            class="patron-logo"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- Main partner -->
    <div class="text-center mb-20">
      <h2 class="section-heading text-brand-teal">Partner główny</h2>
      <div class="flex justify-center mt-1">
        <a
          href={mainPartner.url}
          target="_blank"
          rel="noopener noreferrer"
          class="sponsor-card group"
          title={mainPartner.name}
        >
          <div class="main-partner-logo-wrap">
            <img
              src={mainPartner.logo}
              alt={mainPartner.name}
              class="sponsor-logo"
              loading="lazy"
            />
          </div>
        </a>
      </div>
    </div>

    <!-- Sponsors grid -->
    <div class="text-center mb-10">
      <h3 class="section-heading section-heading--sm text-ink">Partnerzy</h3>
    </div>
    <div class="flex flex-col items-center gap-8 lg:gap-12 mb-20 mx-auto max-w-5xl">
      {sponsorRows.map((row) => (
        <div class="flex flex-wrap justify-center gap-8 lg:gap-12">
          {row.map((sponsor) => (
            <a
              href={sponsor.url}
              target="_blank"
              rel="noopener noreferrer"
              class="sponsor-card group"
              title={sponsor.name}
            >
              <div class="sponsor-logo-wrap">
                <img
                  src={sponsor.logo}
                  alt={sponsor.name}
                  class="sponsor-logo"
                  loading="lazy"
                  style={sponsor.scale ? `transform: scale(${sponsor.scale});` : undefined}
                />
              </div>
              {sponsor.caption && (
                <div
                  class="sponsor-caption"
                  style={sponsor.captionOffset !== undefined ? `margin-top: ${sponsor.captionOffset}px;` : undefined}
                >
                  {Array.isArray(sponsor.caption)
                    ? sponsor.caption.map((line) => <div>{line}</div>)
                    : sponsor.caption}
                </div>
              )}
            </a>
          ))}
        </div>
      ))}
    </div>

    <!-- CTA for sponsors -->
    <div class="text-center">
      <div class="inline-block bg-brand-teal/5 border border-brand-teal/20 p-8 lg:p-12 max-w-2xl">
        <h3 class="font-headline text-2xl text-ink mb-4">
          Chcesz zostać partnerem?
        </h3>
        <p class="text-ink-muted mb-6">
          Dołącz do grona firm wspierających sport i działalność charytatywną.
          Oferujemy różne pakiety partnerskie dopasowane do Twoich możliwości.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#kontakt" class="btn-primary">
            Skontaktuj się z nami
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-heading {
    font-family: var(--font-headline);
    font-size: 2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .section-heading--sm {
    font-size: 1.25rem;
    letter-spacing: 0.1em;
  }

  .sponsor-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .sponsor-card:hover {
    transform: translateY(-4px);
  }

  .main-partner-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 700px;
    max-width: 90vw;
    padding: 0.25rem 1rem;
  }

  .sponsor-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 288px;
    height: 144px;
    padding: 1.5rem;
  }

  .patron-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 280px;
    max-width: 70vw;
    padding: 1rem;
  }

  .patron-logo {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  .sponsor-logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: opacity 0.3s ease;
    opacity: 0.9;
  }

  .sponsor-card:hover .sponsor-logo {
    opacity: 1;
  }

  .sponsor-caption {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted, #555);
    text-align: center;
  }
</style>
