---
const mainPartner = {
  name: "Pizzeria Kultowa",
  logo: "/sponsors/pizzeria-kultowa.webp",
  url: "https://pizzeriakultowa.pl/",
};

const sponsors = [
  {
    name: "Pawęta - mięsa dojrzewające",
    logo: "/sponsors/paweta.svg",
    url: "https://www.paweta.com/",
  },
  {
    name: "Podkawa",
    logo: "/sponsors/podkawa.png",
    url: "https://podkawa.pl/",
    scale: 1.6,
    hidden: false,
  },
];

const visibleSponsors = sponsors.filter((s) => !s.hidden);
---

<section id="sponsorzy" class="relative py-24 lg:py-32 bg-paper overflow-hidden">
  <!-- Decorative element -->
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-teal via-brand-yellow to-brand-teal"></div>

  <!-- Subtle diagonal background accent -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/2 -right-1/4 w-[80%] h-[200%] bg-brand-teal/[0.02] rotate-12 origin-center"></div>
  </div>

  <div class="container-wide relative z-10">
    <!-- Main partner -->
    <div class="text-center mb-20">
      <h2 class="section-heading text-brand-teal">Partner główny</h2>
      <div class="flex justify-center mt-10">
        <a
          href={mainPartner.url}
          target="_blank"
          rel="noopener noreferrer"
          class="sponsor-card group"
          title={mainPartner.name}
        >
          <div class="main-partner-logo-wrap">
            <img
              src={mainPartner.logo}
              alt={mainPartner.name}
              class="sponsor-logo"
              loading="lazy"
            />
          </div>
        </a>
      </div>
    </div>

    <!-- Sponsors grid -->
    <div class="text-center mb-10">
      <h3 class="section-heading section-heading--sm text-ink">Partnerzy</h3>
    </div>
    <div class="flex flex-wrap justify-center gap-8 lg:gap-12 mb-20">
      {visibleSponsors.map((sponsor) => (
        <a
          href={sponsor.url}
          target="_blank"
          rel="noopener noreferrer"
          class="sponsor-card group"
          title={sponsor.name}
        >
          <div class="sponsor-logo-wrap">
            <img
              src={sponsor.logo}
              alt={sponsor.name}
              class="sponsor-logo"
              loading="lazy"
              style={sponsor.scale ? `transform: scale(${sponsor.scale});` : undefined}
            />
          </div>
        </a>
      ))}
    </div>

    <!-- CTA for sponsors -->
    <div class="text-center">
      <div class="inline-block bg-brand-teal/5 border border-brand-teal/20 p-8 lg:p-12 max-w-2xl">
        <h3 class="font-headline text-2xl text-ink mb-4">
          Chcesz zostać partnerem?
        </h3>
        <p class="text-ink-muted mb-6">
          Dołącz do grona firm wspierających sport i działalność charytatywną.
          Oferujemy różne pakiety partnerskie dopasowane do Twoich możliwości.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#kontakt" class="btn-primary">
            Skontaktuj się z nami
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-heading {
    font-family: var(--font-headline);
    font-size: 2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .section-heading--sm {
    font-size: 1.25rem;
    letter-spacing: 0.1em;
  }

  .sponsor-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .sponsor-card:hover {
    transform: translateY(-4px);
  }

  .main-partner-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 700px;
    max-width: 90vw;
    padding: 1rem;
  }

  .sponsor-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 240px;
    height: 120px;
    padding: 1.5rem;
  }

  .sponsor-logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: opacity 0.3s ease;
    opacity: 0.9;
  }

  .sponsor-card:hover .sponsor-logo {
    opacity: 1;
  }
</style>
